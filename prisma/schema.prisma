// Bar-Baz fruit invoice app — data model
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A pastry shop we distribute fruit to.
model Customer {
  id        String   @id @default(cuid())
  name      String
  address   String?
  /// Location picked on the Tehran map
  lat       Float?
  lng       Float?
  phone     String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]

  @@index([name])
}

/// A fruit we sell. It has no stored price: every price is bargained with the
/// customer and typed on the invoice line itself.
model Fruit {
  id        String   @id @default(cuid())
  name      String   @unique
  unit      String   @default("kg")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoiceItems InvoiceItem[]
}

/// One of the vehicles that carries the boxes out to the shops. An invoice is
/// assigned to exactly one of them when the admin builds it.
model Fleet {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]
}

enum InvoiceStatus {
  DRAFT
  FINAL
}

/// One invoice = one customer on one day.
model Invoice {
  id         String        @id @default(cuid())
  customerId String
  /// Which vehicle carries this load. Null only on invoices that predate fleets;
  /// the admin's form requires one, so new invoices always have it.
  fleetId    String?
  day        DateTime      @db.Date
  status     InvoiceStatus @default(DRAFT)
  /// Sum of all item totals, snapshotted on save
  total      Decimal       @default(0) @db.Decimal(14, 2)
  /// Whether the customer has paid this invoice in full. Cached from
  /// `paidAmount`: true exactly when paidAmount covers `total`.
  paid       Boolean       @default(false)
  /// How much of `total` has been paid so far. A customer settles several
  /// invoices with one payment, which fills the oldest ones first and can
  /// leave one of them part-paid.
  paidAmount Decimal       @default(0) @db.Decimal(14, 2)
  note       String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  fleet    Fleet?        @relation(fields: [fleetId], references: [id], onDelete: Restrict)
  items    InvoiceItem[]

  @@index([customerId, day])
  @@index([day])
  @@index([fleetId, day])
}

/// A line on an invoice. unitPrice is whatever was agreed with this customer
/// for this delivery, so two customers can pay different prices on the same day.
model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  fruitId   String
  /// Weight in kg with 3 decimals, e.g. 3.123. Rests at 0 until the fleet
  /// weighs the boxes, the same way unitPrice rests at 0 until a price is agreed.
  quantity  Decimal @default(0) @db.Decimal(10, 3)
  /// How many boxes/packs this line came in. null = فله, sold loose.
  packCount Int?
  /// Price per kg agreed with this customer for this line, in Toman.
  /// 0 until the haggling at the shop door settles it.
  unitPrice Decimal @default(0) @db.Decimal(12, 2)
  /// quantity * unitPrice, snapshotted
  lineTotal Decimal @default(0) @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  fruit   Fruit   @relation(fields: [fruitId], references: [id], onDelete: Restrict)

  @@unique([invoiceId, fruitId])
  @@index([invoiceId])
}
